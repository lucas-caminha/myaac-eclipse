<div class="eclipse-plugin-page eclipse-monsters-page">
	<header class="eclipse-plugin-hero">
		<span class="eclipse-plugin-kicker">Bestiário do Eclipse</span>
		<h2>Monstros</h2>
		<p>Escolha uma classe do Bestiary para consultar suas criaturas, atributos e recompensas.</p>
	</header>

	<div class="eclipse-bestiary-category-grid" aria-label="Classes do Bestiary">
	{% for category in categories %}
		<a class="eclipse-bestiary-category{% if category.name == selectedCategory %} is-active{% endif %}" href="{{ category.link }}">
			<strong>{{ category.name }}</strong>
			<span class="eclipse-bestiary-category-image">{% if category.image %}<img src="{{ category.image }}" alt="">{% endif %}</span>
			<small>{{ category.total }} {{ category.total == 1 ? 'criatura' : 'criaturas' }}</small>
		</a>
	{% endfor %}
	</div>

	<div class="eclipse-bestiary-results-header">
		<div><span>Classe selecionada</span><h3>{{ selectedCategory }}</h3><p><strong data-visible-monster-count>{{ monsters|length }}</strong> criaturas exibidas</p></div>
		<div class="eclipse-bestiary-actions">
			<input class="eclipse-plugin-search" type="search" placeholder="Buscar nesta classe" data-monster-search>
			{% if isAdmin %}<form action="{{ getLink('monsters') }}" method="post">{{ csrf() }}<input type="hidden" name="reload" value="1"><button class="eclipse-plugin-button eclipse-plugin-button-secondary" type="submit">Atualizar bestiário</button></form>{% endif %}
		</div>
	</div>

	<div class="eclipse-monster-grid" data-monster-grid>
	{% for monster in monsters %}
		<a class="eclipse-monster-card{% if monster.rewardboss %} is-boss{% endif %}" href="{{ getMonsterLink(monster.name, false)|raw }}" data-name="{{ monster.name|lower }}">
			<div class="eclipse-monster-portrait"><img src="{{ monster.img_link }}" alt="{{ monster.name }}"></div>
			<div><strong>{{ monster.name }}</strong><span>{{ monster.rewardboss ? 'Chefe' : selectedCategory }}</span></div>
			<dl><div><dt>Vida</dt><dd>{{ monster.health|number_format(0, ',', '.') }}</dd></div><div><dt>EXP</dt><dd>{{ monster.exp|number_format(0, ',', '.') }}</dd></div></dl>
		</a>
	{% else %}<div class="eclipse-plugin-empty">Nenhuma criatura encontrada nesta classe.</div>{% endfor %}
	</div>
	<div class="eclipse-plugin-empty eclipse-monster-search-empty" data-monster-empty hidden>Nenhuma criatura encontrada com esse nome.</div>
</div>
<script>
var monsterSearch = document.querySelector('[data-monster-search]');
if (monsterSearch) monsterSearch.addEventListener('input', function () {
	var visible = 0;
	document.querySelectorAll('[data-monster-grid] [data-name]').forEach(function (card) {
		var matches = card.dataset.name.indexOf(monsterSearch.value.toLowerCase()) !== -1;
		card.hidden = !matches;
		if (matches) visible++;
	});
	var count = document.querySelector('[data-visible-monster-count]');
	var empty = document.querySelector('[data-monster-empty]');
	if (count) count.textContent = visible;
	if (empty) empty.hidden = visible !== 0;
});
</script>
