<div class="eclipse-plugin-page eclipse-character-market">
	<header class="eclipse-plugin-hero"><span class="eclipse-plugin-kicker">Negociação entre jogadores</span><h2>Mercado de Personagens</h2><p>Negocie personagens com coins de forma automática. Confira nome, nível, vocação e preço antes de confirmar.</p></header>
	{% if logged %}
	<section class="eclipse-plugin-section"><h3>Anunciar personagem</h3><form class="eclipse-market-sell-form" action="{{ getLink('character-sale') }}" method="post">{{ csrf() }}<input type="hidden" name="market_action" value="sell"><label>Personagem<select name="player_id" required><option value="">Selecione</option>{% for player in accountPlayers %}<option value="{{ player.id }}">{{ player.name }} — nível {{ player.level }}, {{ player.vocation_name }}</option>{% endfor %}</select></label><label>Preço em coins<input type="number" name="price" min="25" max="100000" step="1" required></label><button class="eclipse-plugin-button" type="submit"{% if accountPlayers is empty %} disabled{% endif %}>Criar anúncio</button></form>{% if accountPlayers is empty %}<p class="eclipse-plugin-note">Seus personagens offline e ainda não anunciados aparecerão aqui.</p>{% endif %}</section>
	{% else %}<div class="eclipse-plugin-notice">Você pode consultar as ofertas, mas precisa <a href="{{ getLink('account/manage') }}">entrar na conta</a> para comprar ou anunciar.</div>{% endif %}
	<div class="eclipse-market-grid">
	{% for offer in offers %}
		<article class="eclipse-market-card"><a class="eclipse-market-outfit" href="{{ offer.detail_link }}"><img src="{{ offer.outfit }}" alt="{{ offer.name }}"></a><div class="eclipse-market-card-body"><span class="eclipse-market-vocation">{{ offer.vocation_name }}</span><h3><a href="{{ offer.detail_link }}">{{ offer.name }}</a></h3><p>Nível {{ offer.level }} • {{ offer.status_name }}</p><strong class="eclipse-market-price">{{ offer.price|number_format(0, ',', '.') }} coins</strong><a class="eclipse-market-details-link" href="{{ offer.detail_link }}">Ver detalhes</a></div>
		{% if logged %}<form action="{{ getLink('character-sale') }}" method="post">{{ csrf() }}<input type="hidden" name="offer_id" value="{{ offer.id }}">{% if offer.seller_account_id == accountId %}<input type="hidden" name="market_action" value="cancel"><button class="eclipse-plugin-button eclipse-plugin-button-danger" type="submit">Cancelar oferta</button>{% else %}<input type="hidden" name="market_action" value="buy"><button class="eclipse-plugin-button" type="submit" onclick="return confirm('Confirmar a compra de {{ offer.name|e('js') }}?')">Comprar personagem</button>{% endif %}</form>{% endif %}</article>
	{% else %}<div class="eclipse-plugin-empty">Ainda não há personagens anunciados.</div>{% endfor %}
	</div>
</div>
