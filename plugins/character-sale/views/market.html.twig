<div class="eclipse-plugin-page eclipse-character-market eclipse-character-auctions">
	{% if logged %}
	<section class="eclipse-plugin-section eclipse-auction-sell-section">
		<h3>{{ t('market.sell_character') }}</h3>
		<form class="eclipse-market-sell-form" action="{{ getLink('character-sale') }}" method="post">
			{{ csrf() }}
			<input type="hidden" name="market_action" value="sell">
			<label>{{ t('market.character') }}
				<select name="player_id" required>
					<option value="">{{ t('market.select') }}</option>
					{% for player in accountPlayers %}
						<option value="{{ player.id }}">{{ t('market.character_option', {'name': player.name, 'level': player.level, 'vocation': player.vocation_name}) }}</option>
					{% endfor %}
				</select>
			</label>
			<label>{{ t('market.price_coins') }}
				<input type="number" name="price" min="25" max="100000" step="1" required>
			</label>
			<button class="eclipse-plugin-button" type="submit"{% if accountPlayers is empty %} disabled{% endif %}>{{ t('market.create_offer') }}</button>
		</form>
		{% if accountPlayers is empty %}
			<p class="eclipse-plugin-note">{{ t('market.sell_empty') }}</p>
		{% endif %}
	</section>
	{% else %}
	<div class="eclipse-plugin-notice eclipse-auction-login-notice">
		<strong>{{ t('market.login_title') }}</strong>
		<span>{{ t('market.login_hint') }}</span>
		<a class="eclipse-plugin-button" href="{{ getLink('account/manage') }}">{{ t('market.login') }}</a>
	</div>
	{% endif %}

	<section class="eclipse-auction-filter" data-auction-filter>
		<div class="eclipse-auction-filter-title">{{ t('market.filter_offers') }}</div>
		<div class="eclipse-auction-filter-grid">
			<label>{{ t('market.search') }}
				<input type="search" class="eclipse-plugin-search" data-auction-search placeholder="{{ t('market.character_name_placeholder') }}">
			</label>
			<label>{{ t('common.vocation') }}
				<select data-auction-vocation>
					<option value="">{{ t('market.all') }}</option>
					{% for vocationId, vocationName in vocationFilterOptions %}
						<option value="{{ vocationId }}">{{ vocationName }}</option>
					{% endfor %}
				</select>
			</label>
			<label>{{ t('market.min_level') }}
				<input type="number" min="1" step="1" data-auction-min-level placeholder="Ex: 250">
			</label>
			<label>{{ t('market.min_charm') }}
				<input type="number" min="0" step="1" data-auction-min-charm placeholder="Ex: 500">
			</label>
			<label>{{ t('market.max_price') }}
				<input type="number" min="0" step="1" data-auction-max-price placeholder="Coins">
			</label>
			<label>{{ t('common.sort_by') }}
				<select data-auction-sort>
					<option value="recent">{{ t('market.sort_recent') }}</option>
					<option value="main">{{ t('market.sort_main') }}</option>
					<option value="charm">Charm Points</option>
					<option value="price">{{ t('market.sort_price') }}</option>
					<option value="level">{{ t('market.sort_level') }}</option>
					<option value="magic">Magic Level</option>
					<option value="distance">Distance</option>
					<option value="shield">Shielding</option>
				</select>
			</label>
			<button class="eclipse-plugin-button eclipse-plugin-button-secondary" type="button" data-auction-apply>{{ t('market.apply') }}</button>
		</div>
	</section>

	<section class="eclipse-auction-list">
		<div class="eclipse-auction-list-title">
			<strong>{{ t('market.current_offers') }}</strong>
			<span>{{ t(offers|length == 1 ? 'market.result_singular' : 'market.result_plural', {'count': offers|length}) }}</span>
		</div>

		{% for offer in offers %}
			<article class="eclipse-market-card eclipse-auction-card" data-auction-card data-name="{{ offer.name|lower|e('html_attr') }}" data-vocation="{{ offer.vocation }}" data-price="{{ offer.price }}" data-level="{{ offer.level }}" data-posted="{{ offer.posted_sort }}" data-charm="{{ offer.charm_points }}" data-main="{{ offer.main_skill.value }}" data-magic="{{ offer.maglevel }}" data-distance="{{ offer.skill_dist }}" data-shield="{{ offer.skill_shielding }}">
				<div class="eclipse-auction-card-heading">
					<div>
						<a class="eclipse-auction-name" href="{{ offer.detail_link }}">{{ offer.name }}</a>
						<span>{{ t('market.level_vocation_status', {'level': offer.level, 'vocation': offer.vocation_name, 'status': offer.status_name}) }}</span>
					</div>
					<a class="eclipse-market-details-link" href="{{ offer.detail_link }}">{{ t('market.view_details') }}</a>
				</div>

				<a class="eclipse-market-outfit eclipse-auction-outfit" href="{{ offer.detail_link }}">
					<img src="{{ offer.outfit }}" alt="{{ offer.name }}">
				</a>

				<div class="eclipse-auction-summary">
					<div class="eclipse-auction-data">
						<div><span>{{ t('market.main_skill') }}</span><strong>{{ offer.main_skill.label }} {{ offer.main_skill.value }}</strong></div>
						<div><span>Level</span><strong>{{ offer.level }}</strong></div>
						<div><span>Charm Points</span><strong>{{ offer.charm_points|number_format(0, ',', '.') }}</strong></div>
					</div>
					<div class="eclipse-auction-skills">
						{% for skill in offer.skill_preview %}
							<div><span>{{ skill.label }}</span><strong>{{ skill.value }}</strong></div>
						{% endfor %}
					</div>
				</div>

				<aside class="eclipse-auction-bidbox">
					<span>{{ t('market.current_price') }}</span>
					<strong class="eclipse-market-price">{{ offer.price|number_format(0, ',', '.') }} coins</strong>
					{% if logged %}
						<form action="{{ getLink('character-sale') }}" method="post">
							{{ csrf() }}
							<input type="hidden" name="offer_id" value="{{ offer.id }}">
							{% if offer.seller_account_id == accountId %}
								<input type="hidden" name="market_action" value="cancel">
								<button class="eclipse-plugin-button eclipse-plugin-button-danger" type="submit">{{ t('market.cancel_offer') }}</button>
							{% else %}
								<input type="hidden" name="market_action" value="buy">
								<button class="eclipse-plugin-button" type="submit" onclick="return confirm('{{ t('market.confirm_buy', {'name': offer.name})|e('js') }}')">{{ t('market.buy_character') }}</button>
							{% endif %}
						</form>
					{% else %}
						<a class="eclipse-plugin-button" href="{{ getLink('account/manage') }}">{{ t('market.login_to_buy') }}</a>
					{% endif %}
				</aside>
			</article>
		{% else %}
			<div class="eclipse-plugin-empty">{{ t('market.empty') }}</div>
		{% endfor %}
	</section>
</div>
