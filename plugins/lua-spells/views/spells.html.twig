<div class="eclipse-plugin-page eclipse-spells-page">
	<header class="eclipse-plugin-hero">
		<span class="eclipse-plugin-kicker">Conhecimento arcano</span>
		<h2>Magias e Runas</h2>
		<p>Consulte requisitos, palavras mágicas e vocações de cada magia do servidor.</p>
	</header>

	<div class="eclipse-plugin-toolbar eclipse-plugin-toolbar-split">
		<form action="{{ getLink('spells') }}" method="get">
			<label for="spell-vocation">Vocação</label>
			<select id="spell-vocation" name="vocation_id">
				<option value="all"{% if post_vocation_id == 'all' %} selected{% endif %}>Todas</option>
				{% for id, vocation in filter_vocations %}<option value="{{ id }}"{% if id == post_vocation_id %} selected{% endif %}>{{ vocation.name }}</option>{% endfor %}
			</select>
			<button class="eclipse-plugin-button" type="submit">Filtrar</button>
		</form>
		{% if isAdmin %}
		<form action="{{ getLink('spells') }}" method="post">{{ csrf() }}<input type="hidden" name="reload" value="1"><button class="eclipse-plugin-button eclipse-plugin-button-secondary" type="submit">Atualizar magias</button></form>
		{% endif %}
	</div>

	<div class="eclipse-plugin-tabs" data-eclipse-tabs>
		<div class="eclipse-plugin-tab-list" role="tablist">
			<button type="button" class="is-active" data-tab="instant">Instantâneas</button>
			<button type="button" data-tab="conjure">Conjurações</button>
			<button type="button" data-tab="rune">Runas</button>
		</div>
		{% for kind, label in {1: 'instant', 2: 'conjure', 3: 'rune'} %}
		<section class="eclipse-plugin-tab-panel{% if kind == 1 %} is-active{% endif %}" data-panel="{{ label }}">
			<div class="eclipse-plugin-table-wrap"><table class="eclipse-plugin-table"><thead><tr><th>Magia</th><th>Palavras</th><th>Nível</th><th>Mana</th><th>Premium</th><th>Vocações</th></tr></thead><tbody>
			{% for spell in spells %}{% if spell.type == kind %}
				<tr><td><strong>{{ spell.name }}</strong></td><td>{{ spell.words ?: '-' }}</td><td>{{ spell.level }}</td><td>{{ spell.mana }}</td><td>{{ spell.premium == 1 ? 'Sim' : 'Não' }}</td><td>{{ spell.vocations|length > 0 ? spell.vocations|raw : 'Todas' }}</td></tr>
			{% endif %}{% endfor %}
			</tbody></table></div>
		</section>
		{% endfor %}
	</div>
</div>
<script>
document.querySelectorAll('[data-eclipse-tabs]').forEach(function (tabs) {
	tabs.querySelectorAll('[data-tab]').forEach(function (button) {
		button.addEventListener('click', function () {
			tabs.querySelectorAll('[data-tab], [data-panel]').forEach(function (node) { node.classList.remove('is-active'); });
			button.classList.add('is-active');
			tabs.querySelector('[data-panel="' + button.dataset.tab + '"]').classList.add('is-active');
		});
	});
});
</script>
