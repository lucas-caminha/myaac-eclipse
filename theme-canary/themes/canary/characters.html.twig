{% set vocation_label = vocation|lower %}
{% set vocation_banner = '' %}
{% if 'knight' in vocation_label or 'cavaleiro' in vocation_label %}
  {% set vocation_banner = 'knight' %}
{% elseif 'paladin' in vocation_label or 'paladino' in vocation_label %}
  {% set vocation_banner = 'paladin' %}
{% elseif 'monk' in vocation_label or 'monge' in vocation_label %}
  {% set vocation_banner = 'monk' %}
{% elseif 'sorcerer' in vocation_label or 'feiticeiro' in vocation_label %}
  {% set vocation_banner = 'sorcerer' %}
{% elseif 'druid' in vocation_label or 'druida' in vocation_label %}
  {% set vocation_banner = 'druid' %}
{% endif %}

<div class="eclipse-characters-page eclipse-characters-result eclipse-character-compact{% if account.isPremium() %} is-vip-account{% endif %}">
  {% if canEdit %}
    <div class="character-admin-action">
      <a href="admin/?p=players&id={{ player.getId() }}" title="{{ t('characters.edit_admin') }}" target="_blank">
        {% set button_name = t('characters.edit_character') %}
        {% include('buttons.base.html.twig') %}
      </a>
    </div>
  {% endif %}

  <div class="character-profile-header{% if vocation_banner %} is-vocation-{{ vocation_banner }}{% endif %}">
    {% if account.isPremium() %}
      <div class="character-vip-ribbon">VIP</div>
    {% endif %}

    {% if outfit is not null %}
      <div class="character-outfit-frame">
        <img src="{{ outfit }}" alt="{{ t('characters.outfit_alt', {'name': player.getName()}) }}">
      </div>
    {% endif %}

    <div class="character-profile-main">
      <span class="character-profile-kicker">{{ t('characters.profile_kicker') }}</span>
      <h2>{{ player.getName() }}</h2>
      {% if rankingBadges is not empty %}
        <div class="character-ranking-badges" aria-label="{{ t('characters.ranking_badges') }}">
          {% for badge in rankingBadges %}
            <a class="character-ranking-badge is-{{ badge.slug }}" href="{{ getLink('highscores') }}/{{ badge.slug }}" title="{{ t('characters.view_ranking', {'ranking': badge.label}) }}">
              <span class="character-ranking-icon"><img src="{{ badge.icon }}" alt=""></span>
              <span>{{ badge.label }}</span>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="character-profile-status {% if player.isOnline() %}is-online{% else %}is-offline{% endif %}">
      {% if player.isOnline() %}Online{% else %}Offline{% endif %}
    </div>
  </div>

  {% if hidden %}
    <div class="character-hidden-message">
      {{ t('characters.hidden') }}
    </div>
  {% else %}
    <div class="character-info-grid">
      <section class="character-data-card">
        <div class="character-card-title">{{ t('characters.info_title') }}</div>
        <table class="character-data-table">
          <tbody>
          <tr>
            <th>Sex:</th>
            <td>{{ sex }}</td>
          </tr>
          <tr>
            <th>{{ t('common.vocation') }}:</th>
            <td>{{ vocation }}</td>
          </tr>
          <tr>
            <th>Level:</th>
            <td>{{ player.getLevel() }}</td>
          </tr>
          <tr>
            <th>{{ t('characters.achievement_points') }}:</th>
            <td>{{ achievementPoints }}</td>
          </tr>
          <tr>
            <th>{{ t('characters.residence') }}:</th>
            <td>{{ town }}</td>
          </tr>
          <tr>
            <th>{{ t('characters.last_login') }}:</th>
            <td>{% if player.getLastLogin() == 0 %}{{ t('characters.never_logged') }}{% else %}{{ player.getLastLogin()|date("d/m/Y H:i:s") }}{% endif %}</td>
          </tr>
          <tr>
            <th>{{ t('characters.account_status') }}:</th>
            <td>{% if account.isPremium() %}{{ t('characters.premium_account') }}{% else %}{{ t('characters.free_account') }}{% endif %}</td>
          </tr>
          </tbody>
        </table>
      </section>

      <section class="character-data-card">
        <div class="character-card-title">{{ t('characters.account_info') }}</div>
        <table class="character-data-table">
          <tbody>
          <tr>
            <th>{{ t('common.created') }}:</th>
            <td>{{ account.getCreated()|date("d/m/Y H:i:s") }}</td>
          </tr>
          </tbody>
        </table>
      </section>
    </div>

    {% if equipment is not null %}
      <section class="character-equipment-card">
        <div class="character-card-title">{{ t('characters.equipment') }}</div>
        <div class="character-equipment-shell" aria-label="{{ t('characters.equipment_of', {'name': player.getName()}) }}">
          <div class="character-equipment-layout">
            <div class="character-equipment-column">
              <div class="character-equipment-slot">{{ equipment[2]|raw }}</div>
              <div class="character-equipment-slot">{{ equipment[6]|raw }}</div>
              <div class="character-equipment-slot">{{ equipment[9]|raw }}</div>
              <div class="character-equipment-value">Soul: {{ soul }}</div>
            </div>
            <div class="character-equipment-column">
              <div class="character-equipment-slot">{{ equipment[1]|raw }}</div>
              <div class="character-equipment-slot">{{ equipment[4]|raw }}</div>
              <div class="character-equipment-slot">{{ equipment[7]|raw }}</div>
              <div class="character-equipment-slot">{{ equipment[8]|raw }}</div>
            </div>
            <div class="character-equipment-column">
              <div class="character-equipment-slot">{{ equipment[3]|raw }}</div>
              <div class="character-equipment-slot">{{ equipment[5]|raw }}</div>
              <div class="character-equipment-slot">{{ equipment[10]|raw }}</div>
              <div class="character-equipment-value">{% if cap > 0 %}Cap: {{ cap }}{% endif %}</div>
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    <div class="character-skills-card">
      <div class="character-card-title">Skills</div>
      <div class="character-skills-layout character-skills-horizontal">
        <table class="character-skill-table character-skill-strip">
          <thead>
          <tr>
            <th><img src="https://www.tibiawiki.com.br/images/0/05/Journal_Shield.gif" alt="Level"></th>
            <th><img src="https://www.tibiawiki.com.br/images/3/31/Lasting_Exercise_Rod.gif" alt="Magic Level"></th>
            <th><img src="https://www.tibiawiki.com.br/images/8/8a/Pair_of_Iron_Fists.gif" alt="Fist"></th>
            <th><img src="https://www.tibiawiki.com.br/images/3/3b/Lasting_Exercise_Club.gif" alt="Club"></th>
            <th><img src="https://www.tibiawiki.com.br/images/d/db/Lasting_Exercise_Sword.gif" alt="Sword"></th>
            <th><img src="https://www.tibiawiki.com.br/images/4/44/Lasting_Exercise_Axe.gif" alt="Axe"></th>
            <th><img src="https://www.tibiawiki.com.br/images/7/7c/Lasting_Exercise_Bow.gif" alt="Distance"></th>
            <th><img src="https://www.tibiawiki.com.br/images/2/2f/Broken_Wooden_Shield.gif" alt="Defense"></th>
            <th><img src="https://www.tibiawiki.com.br/images/1/1f/Fishing_Rod.gif" alt="Fishing"></th>
          </tr>
          </thead>
          <tbody>
          <tr class="character-skill-labels">
            <td>Level</td>
            <td>ML</td>
            <td>Fist</td>
            <td>Club</td>
            <td>Sword</td>
            <td>Axe</td>
            <td>Dist</td>
            <td>Def</td>
            <td>Fish</td>
          </tr>
          <tr class="character-skill-values">
            <td>{{ player.getLevel() }}</td>
            {% for skill in skills %}
              <td>{{ skill.value }}</td>
            {% else %}
              <td colspan="8">{{ t('characters.skills_unavailable') }}</td>
            {% endfor %}
          </tr>
          </tbody>
        </table>
      </div>
    </div>

    {% if account_players is not null and account_players|length > 0 %}
      <section class="character-data-card character-characters-card">
        <div class="character-card-title">{{ t('characters.characters') }}</div>
        <table class="character-data-table character-list-table">
          <thead>
          <tr>
            <th>{{ t('common.name') }}</th>
            <th>Level</th>
            <th>{{ t('common.vocation') }}</th>
            <th>Status</th>
          </tr>
          </thead>
          <tbody>
          {% for character in account_players %}
            <tr>
              <td>
                <a href="{{ getLink('characters') }}/{{ character.getName()|urlencode }}">{{ character.getName() }}</a>
              </td>
              <td>{{ character.getLevel() }}</td>
              <td>{{ character.getVocationName() }}</td>
              <td>{% if character.isOnline() %}Online{% else %}Offline{% endif %}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </section>
    {% endif %}
  {% endif %}

  {{ hook(constant('HOOK_CHARACTERS_AFTER_SKILLS')) }}
  {{ hook(constant('HOOK_CHARACTERS_AFTER_CHARACTERS')) }}

  <div class="character-search-repeat">
    {{ search_form|raw }}
  </div>
</div>
