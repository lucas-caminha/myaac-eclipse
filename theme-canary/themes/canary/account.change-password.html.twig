{% set title = t('account.change_password') %}
<div class="eclipse-privacy-page eclipse-password-page">
	<section class="privacy-hero">
		<span>{{ t('account.security') }}</span>
		<h2>{{ t('account.change_password') }}</h2>
		<p>{{ t('account.change_password_intro') }}</p>
	</section>

	<form id="form" class="privacy-section eclipse-character-action-form eclipse-password-form" action="{{ getLink('account/change-password') }}" method="post">
		{{ csrf() }}

		<h3>{{ t('account.password_confirmation') }}</h3>
		<p>{{ t('account.change_password_confirm_hint') }}</p>

		<div class="privacy-data-grid eclipse-character-action-card eclipse-password-grid">
			<label class="eclipse-character-field" for="old_password">
				<span>{{ t('account.current_password') }}</span>
				<input type="password" id="old_password" name="old_password" maxlength="29" autocomplete="current-password" autofocus>
				<small>{{ t('account.current_password_hint') }}</small>
			</label>

			{{ hook('HOOK_ACCOUNT_CHANGE_PASSWORD_AFTER_OLD_PASSWORD') }}

			<label class="eclipse-character-field" for="new_password">
				<span>{{ t('account.new_password') }}</span>
				<input type="password" id="new_password" name="new_password" maxlength="29" autocomplete="new-password">
				<small>{{ t('account.new_password_hint') }}</small>
			</label>

			{{ hook('HOOK_ACCOUNT_CHANGE_PASSWORD_AFTER_NEW_PASSWORD') }}

			<label class="eclipse-character-field" for="new_password_confirm">
				<span>{{ t('account.repeat_new_password') }}</span>
				<input type="password" id="new_password_confirm" name="new_password_confirm" maxlength="29" autocomplete="new-password">
				<small>{{ t('account.repeat_new_password_hint') }}</small>
			</label>
		</div>

		<div class="eclipse-character-warning">
			<strong>{{ t('account.attention') }}:</strong> {{ t('account.change_password_warning') }}
		</div>

		<div class="privacy-actions">
			<button type="submit" class="eclipse-btn">{{ t('account.save_new_password') }}</button>
			<a class="eclipse-btn eclipse-btn-secondary" href="{{ getLink('account/manage') }}">{{ t('account.back_to_my_account') }}</a>
		</div>
	</form>
</div>
