<div class="eclipse-lost-account">
	<section class="lost-account-hero">
		<p class="lost-account-eyebrow">{{ t('account.security') }}</p>
		<p>{{ t('account.lost_intro') }}</p>
	</section>

	<form class="lost-account-panel lost-account-form" action="{{ getLink('account/lost/step-1') }}" method="post">
		{{ csrf() }}
		<input type="hidden" name="character" value="">

		<div class="lost-account-field">
			<label for="lost-account-character">{{ t('account.character_name') }}</label>
			<input id="lost-account-character" type="text" name="nick" maxlength="30" autocomplete="off" autofocus required>
			<small>{{ t('account.character_exact_hint') }}</small>
		</div>

		<fieldset class="lost-account-methods">
			<legend>{{ t('account.recovery_method') }}</legend>

			<label class="lost-account-method" for="action_type_email">
				<input type="radio" name="action" id="action_type_email" value="email" required>
				<span>
					<strong>{{ t('account.receive_email_code') }}</strong>
					<small>{{ t('account.receive_email_code_hint') }}</small>
				</span>
			</label>

			<label class="lost-account-method" for="action_type_key">
				<input type="radio" name="action" id="action_type_key" value="recovery-key" required>
				<span>
					<strong>{{ t('account.use_recovery_key') }}</strong>
					<small>{{ t('account.use_recovery_key_hint') }}</small>
				</span>
			</label>
		</fieldset>

		<div class="lost-account-actions">
			<a class="lost-account-button lost-account-button-secondary" href="{{ getLink('account/login') }}">{{ t('account.cancel') }}</a>
			<button class="lost-account-button" type="submit">{{ t('account.continue') }}</button>
		</div>
	</form>

	<p class="lost-account-security-note">{{ t('account.lost_security_note') }}</p>
</div>
