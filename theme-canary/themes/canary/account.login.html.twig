{{ hook('HOOK_ACCOUNT_LOGIN_BEFORE_PAGE') }}
<div class="eclipse-login-page">
{% set account_login_label = account_login_by == 'Account Name' ? t('account.account_name') : (account_login_by == 'Email Address' ? 'Email' : account_login_by) %}
<form action="{{ getLink('account/manage') }}" method="post" style="margin: 0; padding: 0;">
	{{ csrf() }}

	{% if redirect is not null %}
		<input type="hidden" name="redirect" value="{{ redirect }}" />
	{% endif %}

	<div class="TableContainer eclipse-login-card eclipse-login-card-account" >
		<div class="CaptionContainer" >
			<div class="CaptionInnerContainer" >
				<span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);" ></span>
				<span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);" ></span>
				<span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);" ></span>
				<span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);" ></span>
				<div class="Text" >{{ t('account.login_title') }}</div>
				<span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);" ></span>
				<span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);" ></span>
				<span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);" ></span>
				<span class="CaptionEdgeRightBottom" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);" ></span>
			</div>
		</div>
		<table class="Table4" cellpadding="0" cellspacing="0" >
			<tr>
				<td>
					<div class="InnerTableContainer">
						<table style="width:100%;">
							<tbody>
							<tr>
								<td>
									<div class="TableShadowContainerRightTop" >
										<div class="TableShadowRightTop" style="background-image:url({{ template_path }}/images/global/content/table-shadow-rt.gif);" ></div>
									</div>
									<div class="TableContentAndRightShadow" style="background-image:url({{ template_path }}/images/global/content/table-shadow-rm.gif);" >
										<div class="TableContentContainer" >
											<table class="TableContent" width="100%" style="border:1px solid #faf0d7;">
											<tbody>
												<tr>
													<td>
														<table style="float: left; width: 100%;" cellpadding="0" cellspacing="0" >
															{{ hook('HOOK_ACCOUNT_LOGIN_BEFORE_ACCOUNT') }}
															<tr>
																<td class="LabelV">
																	<span class="eclipse-login-field-label{% if error is not null %} red{% endif %}" style="color:#000 !important;font-weight:800 !important;text-shadow:none !important;">{{ account_login_label }}:</span>
																</td>
																<td><input class="eclipse-login-input" style="width: 100%; color:#000 !important; -webkit-text-fill-color:#000 !important; font-weight:800 !important; text-shadow:none !important;" type="text" name="account_login" size="35" maxlength="{{ setting('core.account_login_by_email') ? '255' : '30' }}" autofocus /></td>
															</tr>
															{{ hook('HOOK_ACCOUNT_LOGIN_AFTER_ACCOUNT') }}
															<tr>
																<td class="LabelV" ><span class="eclipse-login-field-label{% if error is not null %} red{% endif %}" style="color:#000 !important;font-weight:800 !important;text-shadow:none !important;">{{ t('account.password') }}:</span></td>
																<td>
																	<div class="eclipse-password-field">
																		<input id="password_login" class="eclipse-login-input eclipse-password-input" style="width: 100%; color:#000 !important; -webkit-text-fill-color:#000 !important; font-weight:800 !important; text-shadow:none !important;" type="password" name="password_login" size="35" maxlength="29" autocomplete="current-password" />
																		<button type="button" class="eclipse-password-toggle" style="color:#000 !important;-webkit-text-fill-color:#000 !important;text-shadow:none !important;" aria-label="{{ t('account.show_password') }}" aria-pressed="false">&#128065;</button>
																	</div>
																</td>
															</tr>
															{{ hook('HOOK_ACCOUNT_LOGIN_AFTER_PASSWORD') }}
															<tr>
																<td class="LabelV" ></td>
																<td><input type="checkbox" id="remember_me" name="remember_me" value="true" />
																	<label for="remember_me" style="color:#000 !important;font-weight:800 !important;text-shadow:none !important;"> {{ t('account.remember_access') }}</label></td>
															</tr>
															{{ hook('HOOK_ACCOUNT_LOGIN_AFTER_REMEMBER_ME') }}
														</table>
													</td>
													<td id="LoginFormButtonCell">
														<div style="float: right;" >
															{{ include('buttons.login.html.twig') }}
															<div style="width: 2px; height: 2px;" ></div>
															<a href="{{ getLink('account/lost') }}" style="padding:0;margin:0;" >
																{% set noSubmit = true %}
																{{ include('buttons.account_lost.html.twig') }}
															</a>
														</div>
													</td>
												</tr>
												</tbody>
											</table>
										</div>
									</div>
									<div class="TableShadowContainer" >
										<div class="TableBottomShadow" style="background-image:url({{ template_path }}/images/global/content/table-shadow-bm.gif);" >
											<div class="TableBottomLeftShadow" style="background-image:url({{ template_path }}/images/global/content/table-shadow-bl.gif);" ></div>
											<div class="TableBottomRightShadow" style="background-image:url({{ template_path }}/images/global/content/table-shadow-br.gif);" ></div>
										</div>
									</div>
								</td>
							</tr>
							</tbody>
						</table>
					</div>
				</td>
			</tr>
		</table>
	</div>
</form>
<br/>

<div class="eclipse-login-divider">
	<h1>{{ t('account.new_on_server', {'server': config.lua.serverName}) }}</h1>
</div>
<div class="TableContainer eclipse-login-card eclipse-login-card-new" >
	<div class="CaptionContainer" >
		<div class="CaptionInnerContainer" >
			<span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
			<span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
			<span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);" ></span>
			<span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);"></span>
			<div class="Text" >{{ t('account.new_player') }}</div>
			<span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);"></span>
			<span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);" ></span>
			<span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
			<span class="CaptionEdgeRightBottom" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
		</div>
	</div>
	<table class="Table3" cellpadding="0" cellspacing="0" >
	<tbody>
		<tr>
			<td>
				<div class="InnerTableContainer" >
					<table style="width:100%;" >
					<tbody>
						<tr>
							<td>
								<div class="TableShadowContainerRightTop" >
									<div class="TableShadowRightTop" style="background-image:url({{ template_path }}/images/global/content/table-shadow-rt.gif);" ></div>
								</div>
								<div class="TableContentAndRightShadow" style="background-image:url({{ template_path }}/images/global/content/table-shadow-rm.gif);" >
									<div class="TableContentContainer" >
										<table class="TableContent" width="100%"  style="border:1px solid #faf0d7;" >
										<tbody>
											<tr>
												<td >
													<div style="float: right; margin-top: 20px;" >
														{% apply spaceless %}
														<form class="MediumButtonForm" action="{{ getLink('account/create') }}" method="post" >
															{{ csrf() }}
															<div class="MediumButtonBackground" style="background-image:url({{ template_path }}/images/global/buttons/mediumbutton.gif)" onMouseOver="MouseOverBigButton(this);" onMouseOut="MouseOutBigButton(this);">
																<div class="MediumButtonOver" style="background-image:url({{ template_path }}/images/global/buttons/mediumbutton-over.gif)" onMouseOver="MouseOverBigButton(this);" onMouseOut="MouseOutBigButton(this);"></div>
																<button class="MediumButtonText eclipse-login-create-button" type="submit" name="Create Account">{{ t('account.create_account') }}</button>
															</div>
														</form>
														{% endapply %}
													</div>
													<div id="LoginCreateAccountBox" >
														<p><b>{{ config.lua.serverName }}...</b></p>
														<div style="margin-left: 10px;" >
															<p>{{ t('account.login_pitch_1') }}</p>
															<p>{{ t('account.login_pitch_2') }}</p>
															<p>{{ t('account.login_pitch_3') }}</p>
														</div>
													</div>
												</td>
											</tr>
										</tbody>
										</table>
									</div>
								</div>
								<div class="TableShadowContainer" >
									<div class="TableBottomShadow" style="background-image:url({{ template_path }}/images/global/content/table-shadow-bm.gif);" >
										<div class="TableBottomLeftShadow" style="background-image:url({{ template_path }}/images/global/content/table-shadow-bl.gif);" ></div>
										<div class="TableBottomRightShadow" style="background-image:url({{ template_path }}/images/global/content/table-shadow-br.gif);" ></div>
									</div>
								</div>
							</td>
						</tr>
					</tbody>
					</table>
				</div>
			</td>
		</tr>
	</tbody>
	</table>
</div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
	var toggle = document.querySelector('.eclipse-password-toggle');
	var password = document.getElementById('password_login');
	if (!toggle || !password) {
		return;
	}

	toggle.addEventListener('click', function () {
		var showPassword = password.type === 'password';
		password.type = showPassword ? 'text' : 'password';
		toggle.setAttribute('aria-pressed', showPassword ? 'true' : 'false');
		toggle.setAttribute('aria-label', showPassword ? '{{ t('account.hide_password')|e('js') }}' : '{{ t('account.show_password')|e('js') }}');
	});
});
</script>
{{ hook('HOOK_ACCOUNT_LOGIN_AFTER_PAGE') }}
