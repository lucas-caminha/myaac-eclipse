{% set title = houseName %}
{% set content %}

<div class="eclipse-directory-page eclipse-house-view-page">
	{% if errors is not empty %}
		<div class="directory-note directory-error">
			{% for error in errors %}
				<p>{{ error }}</p>
			{% endfor %}
		</div>
	{% else %}
		<div class="house-view-card">
			<div class="house-image">
				<img src="{{ imgPath }}" alt="{{ houseName }}">
			</div>

			<div class="house-details">
				<h2>{{ houseName }}</h2>
				<p>{{ bedsMessage }} {{ t('houses.view_size', {'size': houseSize})|raw }}</p>

				{% if rentType != 'never' %}
					<p>{{ t('houses.view_rent', {'type': rentType, 'rent': houseRent})|raw }}</p>
				{% endif %}

				{% if owner is not empty %}
					<p>{{ t('houses.view_owner', {'owner': owner|raw})|raw }}</p>
				{% else %}
					<p>{{ t('houses.view_available') }}</p>
				{% endif %}
			</div>
		</div>
	{% endif %}
</div>

{% endset %}
{% include 'tables.headline.html.twig' %}
