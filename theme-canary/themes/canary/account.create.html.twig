														<div class="eclipse-character-name-row">
															<input id="character_name" name="name" maxlength="{{ setting('core.create_character_name_max_length') }}" value="{{ name }}" autocomplete="off"/>
															<img id="character_indicator" src="images/global/general/{% if not save or errors.name is defined %}n{% endif %}ok.gif" alt="" style="display: none;" />
														</div>
														<small>{{ t('account.character_public_name_hint') }}</small>
														<span id="character_error" class="FormFieldError">{% if errors.name is defined %}{{ errors.name }}{% endif %}</span>
													</label>

													<div class="eclipse-character-field">
														<span{% if errors.sex is defined %} class="red"{% endif %}>{{ t('account.sex') }}</span>
														<div class="eclipse-character-choice-row">
