{{ hook('HOOK_ACCOUNT_CREATE_BEFORE_FORM') }}
<div class="eclipse-create-account-page">
{% set eclipse_vocation_guides = {
	'knight': {
		'image': 'knightbanner.png',
		'name': t('account.vocation.knight.name'),
		'role': t('account.vocation.knight.role'),
		'description': t('account.vocation.knight.description')
	},
	'paladin': {
		'image': 'paladinbanner.png',
		'name': t('account.vocation.paladin.name'),
		'role': t('account.vocation.paladin.role'),
		'description': t('account.vocation.paladin.description')
	},
	'monk': {
		'image': 'monkbanner.png',
		'name': t('account.vocation.monk.name'),
		'role': t('account.vocation.monk.role'),
		'description': t('account.vocation.monk.description')
	},
	'sorcerer': {
		'image': 'sorcererbanner.png',
		'name': t('account.vocation.sorcerer.name'),
		'role': t('account.vocation.sorcerer.role'),
		'description': t('account.vocation.sorcerer.description')
	},
	'druid': {
		'image': 'druidbanner.png',
		'name': t('account.vocation.druid.name'),
		'role': t('account.vocation.druid.role'),
		'description': t('account.vocation.druid.description')
	}
} %}
{% set eclipse_gender_labels = {
	'male': t('account.male')|lower,
	'female': t('account.female')|lower
} %}
<form action="{{ getLink('account/create') }}" method="post" id="createaccount">
	{{ csrf() }}

	<div class="eclipse-registration-steps" aria-label="{{ t('account.registration_steps') }}">
		<button type="button" class="eclipse-registration-step is-active" data-registration-step="account">
			<span class="eclipse-registration-step-number">1</span>
			<span class="eclipse-registration-step-text">{{ t('account.access_data') }}</span>
		</button>
		{% if setting('core.account_create_character_create') %}
		<button type="button" class="eclipse-registration-step is-locked" data-registration-step="character" disabled>
			<span class="eclipse-registration-step-number">2</span>
			<span class="eclipse-registration-step-text">{{ t('account.initial_character') }}</span>
		</button>
		{% endif %}
		<button type="button" class="eclipse-registration-step is-locked" data-registration-step="rules" disabled>
			<span class="eclipse-registration-step-number">{% if setting('core.account_create_character_create') %}3{% else %}2{% endif %}</span>
			<span class="eclipse-registration-step-text">{{ t('account.rules') }}</span>
		</button>
	</div>

	{% set title = t('account.create_account_title', {'server': config.lua.serverName}) %}
	{% set background = config('darkborder') %}
	{% set tableClass = 'Table5' %}
	{% set content %}
		<table style="width:100%;" >
			{{ hook('HOOK_ACCOUNT_CREATE_BEFORE_BOXES') }}
			<tr>
				<td>
					<div class="TableShadowContainerRightTop"> <div class="TableShadowRightTop" style="background-image:url({{ template_path }}/images/global/content/table-shadow-rt.gif);"></div></div>
					<div class="TableContentAndRightShadow" style="background-image:url({{ template_path }}/images/global/content/table-shadow-rm.gif);">
						<div class="TableContentContainer">
							<table class="TableContent eclipse-registration-panel is-active" data-registration-panel="account" width="100%" style="border:1px solid #faf0d7;">
								<tbody>
								<tr class="eclipse-registration-panel-intro">
									<td colspan="2">
										<strong>{{ t('account.create_access_data') }}</strong>
										<span>{{ t('account.create_access_hint') }}</span>
									</td>
								</tr>

								{{ hook('HOOK_ACCOUNT_CREATE_BEFORE_ACCOUNT') }}

								{% if not config.account_login_by_email %}
								<tr>
									<td class="LabelV" style="width: 150px">
										<span{% if errors.account is defined %} class="red"{% endif %}>{% if constant('USE_ACCOUNT_NAME') %}{{ t('account.account_name') }}{% else %}{{ t('account.account_number') }}{% endif %}:</span>
										{% if not constant('USE_ACCOUNT_NAME') %}
										<div id="SuggestAccountNumber">[<a href="#">{{ t('account.suggest_number') }}</a>]</div>
										{% endif %}
									</td>
									<td>
										<input type="text" name="account" id="account_input" size="30" maxlength="{% if constant('USE_ACCOUNT_NAME') %}30{% else %}10{% endif %}" value="{{ account }}" autofocus/>
										<img id="account_indicator" src="images/global/general/{% if not save or errors.account is defined %}n{% endif %}ok.gif" style="display: none;" />
									</td>
								</tr>
								{% endif %}
								<tr><td></td><td><span id="account_error" class="FormFieldError">{% if errors.account is defined %}{{ errors.account }}{% endif %}</span></td></tr>
								{% if not config.account_login_by_email %}
								<tr class="eclipse-registration-hint-row"><td></td><td><span class="eclipse-registration-hint">{{ t('account.account_name_hint') }}</span></td></tr>
								{% endif %}
								{{ hook('HOOK_ACCOUNT_CREATE_AFTER_ACCOUNT') }}
								<tr>
									<td class="LabelV" style="width: 150px">
										<span{% if errors.email is defined %} class="red"{% endif %}>Email:</span>
									</td>
									<td>
										<input type="text" name="email" id="email" size="30" maxlength="50" value="{{ email }}" />
										<img id="email_indicator" src="images/global/general/{% if not save or errors.email is defined %}n{% endif %}ok.gif" style="display: none;" />
									</td>
								</tr>
								<tr>
									<td></td><td><span id="email_error" class="FormFieldError">{% if errors.email is defined %}{{ errors.email }}{% endif %}</span></td>
								</tr>
								<tr class="eclipse-registration-hint-row"><td></td><td><span class="eclipse-registration-hint">{{ t('account.email_check_hint') }}</span></td></tr>

								{% if setting('core.mail_enabled') and setting('core.account_mail_verify') %}
									<tr><td></td><td><span><strong>{{ t('account.valid_email_notice') }}</strong></span></td></tr>
								{% endif %}

								{{ hook('HOOK_ACCOUNT_CREATE_AFTER_EMAIL') }}

								{% if setting('core.account_country') %}
									<select name="country" id="account_country" class="eclipse-registration-country-select" aria-hidden="true" tabindex="-1">
										<option value="br" selected>Brazil</option>
									</select>
								{% endif %}

								{{ hook('HOOK_ACCOUNT_CREATE_AFTER_COUNTRY') }}

								<tr>
									<td class="LabelV" style="width: 150px">
										<span{% if errors.password is defined %} class="red"{% endif %}>{{ t('account.password') }}:</span>
									</td>
									<td>
										<input type="password" name="password" id="password" value="" size="30" maxlength="29" />
										<img id="password_indicator" src="images/global/general/{% if not save or errors.password is defined %}n{% endif %}ok.gif" style="display: none;" />
									</td>
								</tr>
								<tr><td></td><td><span id="password_error" class="FormFieldError">{% if errors.password is defined %}{{ errors.password }}{% endif %}</span></td></tr>
								<tr class="eclipse-registration-hint-row"><td></td><td><span class="eclipse-registration-hint">{{ t('account.password_hint') }}</span></td></tr>

								{{ hook('HOOK_ACCOUNT_CREATE_AFTER_PASSWORD') }}

								<tr>
									<td class="LabelV" style="width: 150px">
										<span{% if errors.password is defined %} class="red"{% endif %}>{{ t('account.repeat_password') }}:</span>
									</td>
									<td>
										<input type="password" name="password_confirm" id="password_confirm" value="" size="30" maxlength="29" />
										<img id="password_confirm_indicator" src="images/global/general/{% if not save or errors.password is defined %}n{% endif %}ok.gif" style="display: none;" />
									</td>
								</tr>
								<tr><td></td><td><span id="password_confirm_error" class="FormFieldError">{% if errors.password is defined %}{{ errors.password }}{% endif %}</span></td></tr>

								{{ hook('HOOK_ACCOUNT_CREATE_AFTER_PASSWORDS') }}
								</tbody>
							</table>
						</div>
					</div>
					<div class="TableShadowContainer">
						<div class="TableBottomShadow" style="background-image:url({{ template_path }}/images/global/content/table-shadow-bm.gif);"> <div class="TableBottomLeftShadow" style="background-image:url({{ template_path }}/images/global/content/table-shadow-bl.gif);"></div> <div class="TableBottomRightShadow" style="background-image:url({{ template_path }}/images/global/content/table-shadow-br.gif);"></div> </div></div>
