{% set title = t('houses.title') %}
{% set content %}

<div class="eclipse-directory-page eclipse-houses-page">
	{% if errors is not empty %}
		<div class="directory-note directory-error">
			{% for error in errors %}
				<p>{{ error }}</p>
			{% endfor %}
		</div>
	{% else %}
		{% if cleanOldHouse is not empty or rentType != 'never' %}
			<div class="directory-hint">
				{{ t('houses.clean_hint', {'days': cleanOldHouse, 'rent': rentType}) }}
			</div>
		{% endif %}

		{% if houses is not empty or housesSearch %}
			<div class="directory-card">
				<div class="directory-card-title">{{ townName is not empty ? t('houses.availability_town', {'town': townName}) : t('houses.availability') }}</div>
				<table class="directory-table">
					<tbody>
					{% if houses is not empty %}
						<tr class="LabelH">
							<td>{{ t('common.name') }}</td>
							<td>{{ t('houses.size') }}</td>
							<td>{{ t('houses.rent') }}</td>
							<td>Status</td>
							<td></td>
						</tr>

						{% for house in houses %}
							<tr>
								<td><strong class="directory-primary-name">{{ house.name }}</strong></td>
								<td><span class="directory-pill">{{ t('houses.sqm', {'size': house.size}) }}</span></td>
								<td><span class="directory-pill">{{ t('houses.gold', {'rent': house.rent}) }}</span></td>
								<td><span class="directory-status-text">{{ house.rentedBy|raw }}</span></td>
								<td class="directory-action">
									<a href="{{ house.link }}">{{ include('buttons.view.html.twig') }}</a>
								</td>
							</tr>
						{% endfor %}
					{% else %}
						<tr>
							<td class="directory-empty">{{ t('houses.empty') }}</td>
						</tr>
					{% endif %}
					</tbody>
				</table>
			</div>
		{% endif %}

		<form action="{{ getLink('houses') }}" method="post" class="directory-card directory-form">
			<div class="directory-card-title">{{ t('houses.search_title') }}</div>
			<div class="houses-filter-grid">
				<div>
					<strong>{{ t('houses.city') }}</strong>
					{% set checked = false %}
					{% for id, name in config.towns %}
						{% if id > 0 %}
							{% if ((townId is empty and name is not empty) or id == townId) and not checked %}
								{% set variable = "checked" %}
								{% set checked = true %}
							{% else %}
								{% set variable = "" %}
							{% endif %}
							<label><input type="radio" name="town" value="{{ id }}"{% if variable is defined %} {{ variable }}{% endif %}> {{ name }}</label>
						{% endif %}
					{% endfor %}
				</div>

				<div>
					<strong>Status</strong>
					<label><input type="radio" name="state" value=""{% if state is empty %} checked{% endif %}> {{ t('common.all') }}</label>
					<label><input type="radio" name="state" value="free"{% if state == 'free' %} checked{% endif %}> {{ t('houses.free') }}</label>
					<label><input type="radio" name="state" value="rented"{% if state == 'rented' %} checked{% endif %}> {{ t('houses.rented') }}</label>
				</div>

				<div>
					<strong>{{ t('common.sort_by') }}</strong>
					<label><input type="radio" name="order" value=""{% if order is empty %} checked{% endif %}> {{ t('common.name') }}</label>
					<label><input type="radio" name="order" value="size"{% if order == 'size' %} checked{% endif %}> {{ t('houses.size') }}</label>
					<label><input type="radio" name="order" value="rent"{% if order == 'rent' %} checked{% endif %}> {{ t('houses.rent') }}</label>
				</div>

				<div>
					<strong>{{ t('common.type') }}</strong>
					<label><input type="radio" name="type" value=""{% if type is empty %} checked{% endif %}> {{ t('common.all') }}</label>
					<label><input type="radio" name="type" value="houses"{% if type == 'houses' %} checked{% endif %}> {{ t('houses.houses_flats') }}</label>
					<label><input type="radio" name="type" value="guildhalls"{% if type == 'guildhalls' %} checked{% endif %}> guildhalls</label>
				</div>
			</div>

			<div class="directory-submit">
				{{ include('buttons.submit.html.twig') }}
			</div>
		</form>
	{% endif %}
</div>

{% endset %}
{% include 'tables.headline.html.twig' %}
