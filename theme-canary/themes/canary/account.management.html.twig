												<div style="justify-content: flex-start">
													<img class="PremiumFeatureImage1"
														 src="{{ template_path }}/images/premiumfeatures/PremiumIcon-Travel.png"
														 alt="premium feature 1" style="margin:0px 5px">
													<div>{{ t('account.instant_travel') }}</div>
												</div>
												<div style="justify-content: center">
													<img class="PremiumFeatureImage1"
														 src="{{ template_path }}/images/premiumfeatures/PremiumIcon-VIPGroups.png"
														 alt="premium feature 1" style="margin:0px 5px">
													<div>{{ t('account.vip_groups') }}</div>
												</div>
												<div style="justify-content: flex-end">
													<img class="PremiumFeatureImage1"
														 src="{{ template_path }}/images/premiumfeatures/PremiumIcon-Promotion.png"
														 alt="premium feature 1" style="margin:0px 5px">
													<div>{{ t('account.promotion') }}</div>
												</div>
											</td>
										</tr>
										</tbody>
									</table>
								</div>
							</td>
						</tr>
						</tbody>
