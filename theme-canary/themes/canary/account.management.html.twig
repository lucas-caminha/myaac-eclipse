{% if duo_invites is defined and duo_invites is not empty and duo_invites_rendered is not defined %}
	<div class="eclipse-duo-invites">
		<div class="duo-invites-title">
			<strong>{{ t('account.duo_invite_title') }}</strong>
			<span>{{ t('account.duo_invite_intro') }}</span>
		</div>
		<div class="duo-invites-list">
			{% for invite in duo_invites %}
				<div class="duo-invite-card">
					<div>
						<strong>{{ t('account.duo_invite_line', {'payer': invite.payer_player_name, 'partner': invite.partner_player_name}) }}</strong>
						<span>{{ t('account.duo_invite_details', {'amount': (invite.amount_brl_cents / 100)|number_format(2, ',', '.'), 'coins': invite.partner_coins|number_format(0, ',', '.'), 'outfit': invite.outfit_name}) }}</span>
						<small>{{ t('account.expires_at', {'date': invite.expires_at|date('d/m/Y H:i')}) }}</small>
					</div>
					<div class="duo-invite-actions">
						<form method="post" action="{{ getLink('duo-donate') }}">
							{{ csrf() }}
							<input type="hidden" name="duo_action" value="accept">
							<input type="hidden" name="token" value="{{ invite.partner_token }}">
							<button type="submit">{{ t('account.accept') }}</button>
						</form>
						<form method="post" action="{{ getLink('duo-donate') }}">
							{{ csrf() }}
							<input type="hidden" name="duo_action" value="decline">
							<input type="hidden" name="token" value="{{ invite.partner_token }}">
							<button type="submit" class="secondary">{{ t('account.decline') }}</button>
						</form>
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
{% endif %}

