<style>
  #News:has(.eclipse-server-info) > img.Title {
    display: none !important;
  }

  #News:has(.eclipse-server-info) > .BorderTitleText::after {
    content: "{{ t('ots_info.page_title') }}";
    display: flex;
    align-items: center;
    height: 100%;
    padding-left: 14px;
    color: #f7e7bd !important;
    font: 900 18px Georgia, "Times New Roman", serif;
    text-shadow: 0 2px 0 #1c0905, 0 0 8px rgba(255, 176, 69, .55) !important;
  }
</style>

<div class="eclipse-server-info">
  <section class="serverinfo-hero">
    <h1>{{ config.lua.serverName }}</h1>
  </section>

  <section id="server-commands" class="serverinfo-card serverinfo-commands-card">
    <div class="serverinfo-card-title">{{ t('ots_info.commands') }}</div>
    <div class="serverinfo-commands-body">
      {% if commandsPage %}
        {{ commandsPage.body|raw }}
      {% else %}
        <p>{{ t('ots_info.commands_empty') }}</p>
      {% endif %}
    </div>
  </section>

  <section id="server-details" class="serverinfo-card">
      <div class="serverinfo-card-title">{{ t('ots_info.server_info') }}</div>
      <div class="serverinfo-overview">
        <div class="serverinfo-feature-card is-primary">
          <span>{{ t('ots_info.connection') }}</span>
          <strong>{{ serverIp }}</strong>
          <small>{{ t('ots_info.port_client', {'port': config.lua.loginPort ?? config.lua.loginProtocolPort, 'client': clientVersion}) }}</small>
        </div>
        <div class="serverinfo-feature-card">
          <span>Server Save</span>
          <strong>{{ serverSave.0 }}:{{ serverSave.1 }}</strong>
          <small>Uptime: {{ status.uptimeReadable }}</small>
        </div>
        <div class="serverinfo-feature-card">
          <span>{{ t('common.world') }}</span>
          <strong>{{ config.lua.worldType|upper }}</strong>
          <small>{{ t('ots_info.protection_level', {'level': protectionLevel}) }}</small>
        </div>
      </div>

      <dl class="serverinfo-list serverinfo-compact-list">
        <div><dt>Loot</dt><dd>x{{ rateLoot }}</dd></div>
        <div><dt>Spawn</dt><dd>x{{ rateSpawn }}</dd></div>
        <div><dt>{{ t('ots_info.house_rent') }}</dt><dd>{{ houseRent }}</dd></div>
        <div><dt>{{ t('ots_info.guild_level') }}</dt><dd>{% if config.guild_need_level > 0 %}{{ config.guild_need_level }}{% else %}{{ t('common.no_requirement') }}{% endif %}</dd></div>
        {% if houseLevel %}
          <div><dt>{{ t('ots_info.house_buy_level') }}</dt><dd>{{ houseLevel }}</dd></div>
        {% endif %}
      </dl>
      {% if houseOld %}
        <p class="serverinfo-muted">{{ t('ots_info.house_old') }}</p>
      {% endif %}
    </section>

  <section id="server-rates" class="serverinfo-card">
      <div class="serverinfo-card-title">{{ t('ots_info.rates') }}</div>
      {% if not rateUseStages %}
        <div class="serverinfo-rate-tiles">
          <div><span>x{{ rateExp }}</span><small>{{ t('vip.benefit.exp') }}</small></div>
          <div><span>x{{ rateMagic }}</span><small>{{ t('common.magic_level') }}</small></div>
          <div><span>x{{ rateSkill }}</span><small>{{ t('common.skills') }}</small></div>
        </div>
      {% else %}
        <div class="serverinfo-stage-table-wrap">
          <h3>{{ t('vip.benefit.exp') }}</h3>
          <div class="serverinfo-rate-chart" aria-label="{{ t('ots_info.exp_rates_aria') }}">
            {% for result in rateStages.experienceStages %}
              <div class="serverinfo-rate-row">
                <span class="serverinfo-rate-range">Lv. {{ result.minlevel }}{% if result.maxlevel is not empty %}–{{ result.maxlevel }}{% else %}+{% endif %}</span>
                <span class="serverinfo-rate-track"><span style="width: {{ result.chartPercent }}%"></span></span>
                <strong>{{ result.multiplier }}x</strong>
              </div>
            {% endfor %}
          </div>

          <h3>{{ t('common.skills') }}</h3>
          <div class="serverinfo-rate-chart" aria-label="{{ t('ots_info.skill_rates_aria') }}">
            {% for result in rateStages.skillsStages %}
              <div class="serverinfo-rate-row">
                <span class="serverinfo-rate-range">Lv. {{ result.minlevel }}{% if result.maxlevel is not empty %}–{{ result.maxlevel }}{% else %}+{% endif %}</span>
                <span class="serverinfo-rate-track"><span style="width: {{ result.chartPercent }}%"></span></span>
                <strong>{{ result.multiplier }}x</strong>
              </div>
            {% endfor %}
          </div>

          <h3>{{ t('common.magic_level') }}</h3>
          <div class="serverinfo-rate-chart" aria-label="{{ t('ots_info.magic_rates_aria') }}">
            {% for result in rateStages.magicLevelStages %}
              <div class="serverinfo-rate-row">
                <span class="serverinfo-rate-range">ML {{ result.minlevel }}{% if result.maxlevel is not empty %}–{{ result.maxlevel }}{% else %}+{% endif %}</span>
                <span class="serverinfo-rate-track"><span style="width: {{ result.chartPercent }}%"></span></span>
                <strong>{{ result.multiplier }}x</strong>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
  </section>

  <section id="server-pvp" class="serverinfo-card">
      <div class="serverinfo-card-title">{{ t('ots_info.pvp_system') }}</div>
      <dl class="serverinfo-list">
        <div><dt>PZ Lock</dt><dd>{{ pzLocked / (60 * 1000) }} min</dd></div>
        <div><dt>{{ t('ots_info.frag_duration') }}</dt><dd>{{ t('ots_info.hours', {'count': 7}) }}</dd></div>
        <div><dt>Red Skull</dt><dd>{{ t('ots_info.days', {'count': redSkullDuration}) }}</dd></div>
        {% if blackSkullDuration %}
          <div><dt>Black Skull</dt><dd>{{ t('ots_info.days', {'count': blackSkullDuration}) }}</dd></div>
        {% endif %}
        {% if dailyFragsToRedSkull is defined %}
          <div><dt>Red Skull</dt><dd>{{ t('ots_info.frags_periods', {'daily': dailyFragsToRedSkull, 'weekly': weeklyFragsToRedSkull, 'monthly': monthlyFragsToRedSkull}) }}</dd></div>
          <div><dt>Black Skull</dt><dd>{{ t('ots_info.frags_periods', {'daily': dailyFragsToRedSkull * 2, 'weekly': weeklyFragsToRedSkull * 2, 'monthly': monthlyFragsToRedSkull * 2}) }}</dd></div>
        {% endif %}
      </dl>
  </section>

  <p class="serverinfo-footer-note">{{ t('ots_info.report_note') }}</p>
</div>
