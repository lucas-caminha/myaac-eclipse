{% set title = 'Criar Personagem' %}
<div class="eclipse-privacy-page eclipse-create-character-page">
{% set eclipse_vocation_guides = {
	'knight': {
		'image': 'knightbanner.png',
		'role': 'Defensor de linha de frente',
		'description': 'Ideal para combate corpo a corpo, armaduras pesadas, escudos e pressão constante no centro da luta.'
	},
	'paladin': {
		'image': 'paladinbanner.png',
		'role': 'Híbrido de longa distância',
		'description': 'Um atirador flexível que mistura dano à distância, sobrevivência e magia útil.'
	},
	'monk': {
		'image': 'monkbanner.png',
		'role': 'Espírito marcial',
		'description': 'Um lutador disciplinado que combina força física com técnicas espirituais.'
	},
	'sorcerer': {
		'image': 'sorcererbanner.png',
		'role': 'Dano elemental',
		'description': 'Focado em magias destrutivas, dano explosivo e grande poder ofensivo.'
	},
	'druid': {
		'image': 'druidbanner.png',
		'role': 'Suporte e cura',
		'description': 'Um conjurador da natureza com cura, suporte e utilidade confiável em grupo.'
	}
} %}

<section class="privacy-hero">
	<span>Novo personagem</span>
	<h2>Escolha sua vocação e comece sua jornada</h2>
	<p>Defina um nome, selecione o sexo e escolha a vocação que combina com seu estilo de jogo. O nome precisa respeitar as <a href="?subtopic=rules" target="_blank" rel="noopener">regras do Eclipse OT</a>.</p>
</section>

{% if account_logged.getPlayersList(true)|length >= setting('core.characters_per_account') %}
	<div class="eclipse-character-create-alert">
		Você atingiu o limite de personagens por conta. Apague um personagem antes de criar outro.
	</div>
{% endif %}

<form id="form" class="eclipse-character-create-form" action="{{ getLink('account/characters/create') }}" method="post">
	{{ csrf() }}
	<input type="hidden" name="save" value="1">

	{{ hook('HOOK_ACCOUNT_CREATE_CHARACTER_BEFORE_FIRST_TABLE') }}

	<section class="privacy-section eclipse-character-create-section">
		<div class="eclipse-character-create-section-title">
			<span>1</span>
			<div>
				<h3>Identidade</h3>
				<p>Escolha como seu personagem vai aparecer no jogo.</p>
			</div>
		</div>

		<div class="eclipse-character-create-grid">
			<label class="eclipse-character-field" for="character_name">
				<span>Nome do personagem</span>
				<div class="eclipse-character-name-row">
					<input name="name" id="character_name" value="{{ name }}" maxlength="{{ setting('core.create_character_name_max_length') }}" autocomplete="off">
					<img id="character_indicator" src="images/global/general/{% if not save or errors.name is defined %}n{% endif %}ok.gif" alt="">
				</div>
				<small id="character_error">{% if not save or errors.name is defined %}Digite um nome válido para o personagem.{% endif %}</small>
			</label>

			<div class="eclipse-character-field">
				<span>Sexo</span>
				<div class="eclipse-character-choice-row">
					{% set i = 0 %}
					{% for id, gender in config.genders|reverse(true) %}
						{% set i = i + 1 %}
						{% set gender_slug = gender|lower %}
						<label class="eclipse-character-choice" for="sex{{ i }}">
							<input type="radio" name="sex" id="sex{{ i }}" value="{{ id }}"{% if sex is not null and sex == id %} checked="checked"{% endif %}>
							<span>{% if gender_slug == 'male' %}Masculino{% elseif gender_slug == 'female' %}Feminino{% else %}{{ gender }}{% endif %}</span>
						</label>
					{% endfor %}
				</div>
			</div>
		</div>
	</section>

	{{ hook('HOOK_ACCOUNT_CREATE_CHARACTER_BEFORE_VOCATION') }}

	{% if config.character_samples|length > 1 %}
	<section class="privacy-section eclipse-character-create-section">
		<div class="eclipse-character-create-section-title">
			<span>2</span>
			<div>
				<h3>Vocação</h3>
				<p>Cada vocação tem uma proposta diferente para hunts, bosses e guerras.</p>
			</div>
		</div>

		<div class="eclipse-vocation-grid eclipse-character-vocation-grid">
			{% for key, sample_char in config.character_samples %}
				{% set vocation_name = config['vocations'][key] %}
				{% set vocation_slug = vocation_name|lower|replace({' ': ''}) %}
				{% set guide = eclipse_vocation_guides[vocation_slug]|default(null) %}
				<label class="eclipse-vocation-card{% if vocation is not null and vocation == key %} is-selected{% endif %}" for="vocation{{ key }}">
					<input type="radio" name="vocation" id="vocation{{ key }}" value="{{ key }}"
					{% if vocation is not null and vocation == key %} checked="checked"{% endif %}>
					{% if guide %}
						<img src="{{ template_path }}/images/vocations/{{ guide.image }}" alt="{{ vocation_name }}" loading="lazy">
					{% endif %}
					<span class="eclipse-vocation-name">{{ vocation_name }}</span>
					{% if guide %}
						<span class="eclipse-vocation-role">{{ guide.role }}</span>
						<span class="eclipse-vocation-description">{{ guide.description }}</span>
					{% endif %}
				</label>
			{% endfor %}
		</div>
	</section>
	{% endif %}

	{{ hook('HOOK_ACCOUNT_CREATE_CHARACTER_BEFORE_TOWNS') }}

	{% if config.character_towns|length > 1 %}
	<section class="privacy-section eclipse-character-create-section">
		<div class="eclipse-character-create-section-title">
			<span>3</span>
			<div>
				<h3>Cidade inicial</h3>
				<p>Escolha onde seu personagem vai começar.</p>
			</div>
		</div>
		<div class="eclipse-character-choice-row">
			{% for town_id in config.character_towns %}
				<label class="eclipse-character-choice" for="town{{ town_id }}">
					<input type="radio" name="town" id="town{{ town_id }}" value="{{ town_id }}"
					{% if town is not null and town == town_id %} checked="checked"{% endif %}>
					<span>{{ config.towns[town_id] }}</span>
				</label>
			{% endfor %}
		</div>
	</section>
	{% endif %}

	{{ hook('HOOK_ACCOUNT_CREATE_CHARACTER_AFTER_TOWNS') }}
	{{ hook('HOOK_ACCOUNT_CREATE_CHARACTER_AFTER_SECOND_TABLE') }}

	<div class="privacy-actions">
		<button type="submit" class="eclipse-btn">Criar personagem</button>
		<a class="eclipse-btn eclipse-btn-secondary" href="{{ getLink('account/manage') }}">Voltar para minha conta</a>
	</div>
</form>

<script type="text/javascript" src="tools/check_name.js"></script>
</div>
