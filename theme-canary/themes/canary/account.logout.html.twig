<div class="eclipse-success-page eclipse-account-feedback">
	<div class="eclipse-success-panel">
		<div class="eclipse-success-title">{{ t('account.logout_title') }}</div>
		<div class="eclipse-success-body">
			{{ t('account.logout_body', {
				'server': '<strong>' ~ config.lua.serverName ~ '</strong>',
				'login': '<a href="' ~ getLink('account/manage') ~ '">' ~ t('account.login_link') ~ '</a>'
			})|raw }}
		</div>
	</div>

	<div class="eclipse-success-actions">
		<a class="eclipse-btn" style="color:#fff8dc !important;-webkit-text-fill-color:#fff8dc !important;text-shadow:0 1px 1px #000 !important;" href="{{ getLink('account/manage') }}">{{ t('account.login_again') }}</a>
		<a class="eclipse-btn eclipse-btn-secondary" style="color:#fff8dc !important;-webkit-text-fill-color:#fff8dc !important;text-shadow:0 1px 1px #000 !important;" href="{{ getLink('news') }}">{{ t('account.back_home') }}</a>
	</div>
</div>
